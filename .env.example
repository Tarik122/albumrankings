# Copy to .env.local and fill in. See SETUP.md for where each value comes from.
#
# None of these are secrets. The built bundle is served publicly from GitHub
# Pages, so everything here is visible to anyone who views source. Access
# control lives in firestore.rules, which pins the database to VITE_OWNER_UID.

# Firebase console > Project settings > Your apps > SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Leave blank on first run. Sign in once, copy the UID the Settings tab shows
# you, then set it here AND in firestore.rules.
VITE_OWNER_UID=

# Spotify developer dashboard > your app > Settings > Client ID
VITE_SPOTIFY_CLIENT_ID=

# Only needed if you deploy somewhere other than
# https://<user>.github.io/albumrankings/ — e.g. VITE_BASE=/ for a custom domain.
# VITE_BASE=/albumrankings/
